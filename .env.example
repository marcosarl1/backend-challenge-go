# Valores locais para o fluxo no host (`make run`). O serviço `app` do Compose
# usa hostnames internos (db, sqs, keycloak); veja o `compose.yaml`.
HTTP_ADDR=:8081
METRICS_ADDR=127.0.0.1:9090
DATABASE_URL=postgres://app:app@localhost:5432/wagering?sslmode=disable
SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
AWS_REGION=us-east-1
OIDC_ISSUER=http://localhost:8080/realms/wagering
OIDC_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api
CONSUMER_NAME=wager-consumer
CONSUMER_WORKERS=4
CONSUMER_POLL=20s
OUTBOX_OWNER=outbox-1
OUTBOX_BATCH=10
OUTBOX_INTERVAL=1s
RETRY_BATCH=10
RETRY_INTERVAL=5s
SHUTDOWN_TIMEOUT=15s
OTEL_EXPORTER_OTLP_ENDPOINT=

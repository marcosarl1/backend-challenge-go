{
  "realm": "wagering",
  "enabled": true,
  "displayName": "Wagering",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "provider",
        "description": "Provedor de jogos: envia e consulta as proprias operacoes"
      },
      {
        "name": "internal",
        "description": "Servico interno: gerencia carteiras e leituras administrativas"
      }
    ]
  },
  "clients": [
    {
      "clientId": "provider-a",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wagering-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-b-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wagering-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "wallet-internal",
      "enabled": true,
      "publicClient": false,
      "secret": "wallet-internal-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wagering-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-wallet-internal",
      "enabled": true,
      "serviceAccountClientId": "wallet-internal",
      "realmRoles": ["internal"]
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyPlainHTTP",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "sqs:*",
      "Resource": "arn:aws:sqs:us-east-1:111111111111:wager-transactions-provider-b.fifo",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "AllowCrossAccountProviderB",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::222222222222:role/wager-producer-b"
      },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:111111111111:wager-transactions-provider-b.fifo"
    }
  ]
}
